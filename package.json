{
  "name": "paytrack-root",
  "version": "1.0.0",
  "description": "PayTrack - Simple & Mobile-Friendly Payment Management Website",
  "main": "server.js",
  "scripts": {
    "build": "echo 'Backend ready'",
    "start": "node server/server.js",
    "start:backend": "node backend/server.js",
    "start:frontend": "npm --prefix frontend run dev",

    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6"
  },
  "keywords": [
    "payment",
    "management",
    "react",
    "nodejs",
    "mysql"
